STATION_HOST=0.0.0.0
STATION_PORT=8765
STATION_API_KEY=change-me
STATION_DB_PATH=data/station.db
STATION_LOG_DIR=logs
STATION_TZ=America/New_York
STATION_LUX_PER_PPFD=54
STATION_SUN_THRESHOLD_LUX=20000
# Proxy addresses or networks whose X-Forwarded-For is trusted. On the VPS,
# the Docker network nginx connects from.
STATION_FORWARDED_ALLOW_IPS=127.0.0.1
